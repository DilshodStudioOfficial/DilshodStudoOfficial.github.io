<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Cyber Monitor UI</title>
<style>
  :root{
    --bg:#02070a;
    --panel:#061115;
    --line:#0dff8a;
    --line2:#00b86b;
    --text:#bfffdc;
    --muted:#5cae86;
    --danger:#ff4d67;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:radial-gradient(circle at 50% 0,#073326 0,#02070a 35%,#000 100%);font-family:Consolas,Monaco,monospace;color:var(--text);overflow:hidden}
  body:before{
    content:"";position:fixed;inset:0;pointer-events:none;
    background:repeating-linear-gradient(0deg,rgba(255,255,255,.02) 0,rgba(255,255,255,.02) 1px,transparent 1px,transparent 4px);
    mix-blend-mode:screen;
  }
  .app{height:100vh;display:grid;grid-template-rows:58px 1fr 34px}
  header{display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid #0a6f48;background:rgba(0,10,12,.92);box-shadow:0 0 24px #00ff8830}
  .brand{font-weight:800;letter-spacing:2px}
  .brand span{color:var(--line)}
  .status{display:flex;gap:14px;font-size:12px;color:var(--muted)}
  .dot{width:8px;height:8px;border-radius:50%;display:inline-block;background:var(--line);box-shadow:0 0 12px var(--line);margin-right:6px}
  main{display:grid;grid-template-columns:1.35fr .9fr;gap:10px;padding:10px;min-height:0}
  .left,.right{display:grid;gap:10px;min-height:0}
  .left{grid-template-rows:1.2fr .8fr}
  .right{grid-template-rows:.8fr 1.2fr}
  .panel{position:relative;border:1px solid #0d6d48;background:linear-gradient(180deg,rgba(2,20,20,.95),rgba(0,6,8,.96));box-shadow:inset 0 0 28px #00ff8810,0 0 18px #00ff8810;overflow:hidden;border-radius:6px}
  .panel h3{margin:0;padding:9px 12px;font-size:12px;letter-spacing:1.5px;color:#7cffbc;border-bottom:1px solid #0b4f38;background:#051519}
  .terminal{height:calc(100% - 35px);padding:12px;font-size:13px;line-height:1.5;overflow:hidden}
  .line{white-space:pre-wrap}
  .prompt{color:var(--line)}
  .warn{color:#ffd166}
  .bad{color:var(--danger)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:10px;height:calc(100% - 35px)}
  .metric{border:1px solid #0a5339;padding:10px;background:#03100e;display:flex;flex-direction:column;justify-content:space-between}
  .metric b{font-size:23px;color:var(--line);text-shadow:0 0 10px #00ff8840}
  .bar{height:7px;background:#08241b;margin-top:8px;overflow:hidden}
  .bar i{display:block;height:100%;background:linear-gradient(90deg,#00a95f,#17ff91);box-shadow:0 0 8px var(--line)}
  .map{height:calc(100% - 35px);position:relative;background:
    linear-gradient(#00ff880d 1px,transparent 1px),
    linear-gradient(90deg,#00ff880d 1px,transparent 1px);
    background-size:30px 30px;
  }
  .radar{position:absolute;left:50%;top:50%;width:260px;height:260px;transform:translate(-50%,-50%);border:1px solid #0aff8b88;border-radius:50%;box-shadow:0 0 25px #00ff8822 inset}
  .radar:before,.radar:after{content:"";position:absolute;inset:20%;border:1px solid #0aff8b55;border-radius:50%}
  .radar:after{inset:38%}
  .sweep{position:absolute;left:50%;top:50%;width:130px;height:2px;background:linear-gradient(90deg,#00ff88,transparent);transform-origin:left center;animation:spin 4s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  .ping{position:absolute;width:8px;height:8px;border-radius:50%;background:#4dffc0;box-shadow:0 0 14px #00ff88}
  .tablewrap{padding:8px;height:calc(100% - 35px);overflow:hidden}
  table{width:100%;border-collapse:collapse;font-size:11px}
  th,td{padding:7px 6px;border-bottom:1px solid #073b2a;text-align:left}
  th{color:#55d99b;background:#06140f}
  .live{color:var(--line)}
  footer{display:flex;align-items:center;justify-content:space-between;padding:0 12px;border-top:1px solid #0b5138;font-size:11px;color:#55a67f;background:#03100f}
  .cursor{display:inline-block;width:8px;height:14px;background:var(--line);vertical-align:middle;animation:blink .8s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}
  .scanline{position:absolute;left:0;right:0;height:2px;background:#00ff8866;box-shadow:0 0 12px #00ff88;animation:scan 5s linear infinite}
  @keyframes scan{from{top:0}to{top:100%}}
  @media(max-width:800px){
    body{overflow:auto}
    .app{height:auto;min-height:100vh}
    main{grid-template-columns:1fr}
    .left,.right{grid-template-rows:auto}
    .panel{min-height:290px}
  }
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand">DILSHOD <span>CYBER MONITOR</span></div>
    <div class="status"><span><i class="dot"></i>ONLINE</span><span id="clock">--:--:--</span></div>
  </header>

  <main>
    <section class="left">
      <div class="panel">
        <div class="scanline"></div>
        <h3>LIVE TERMINAL</h3>
        <div class="terminal" id="terminal"></div>
      </div>

      <div class="panel">
        <h3>SYSTEM METRICS</h3>
        <div class="grid2">
          <div class="metric"><span>CPU LOAD</span><b id="cpu">43%</b><div class="bar"><i id="cpuBar" style="width:43%"></i></div></div>
          <div class="metric"><span>MEMORY</span><b id="ram">68%</b><div class="bar"><i id="ramBar" style="width:68%"></i></div></div>
          <div class="metric"><span>NETWORK</span><b id="net">126 Mb/s</b><div class="bar"><i id="netBar" style="width:54%"></i></div></div>
          <div class="metric"><span>SECURITY</span><b>ACTIVE</b><div class="bar"><i style="width:92%"></i></div></div>
        </div>
      </div>
    </section>

    <section class="right">
      <div class="panel">
        <h3>NETWORK RADAR</h3>
        <div class="map">
          <div class="radar">
            <div class="sweep"></div>
            <i class="ping" style="left:35%;top:26%"></i>
            <i class="ping" style="left:70%;top:54%"></i>
            <i class="ping" style="left:44%;top:73%"></i>
          </div>
        </div>
      </div>

      <div class="panel">
        <h3>ACTIVE NODES</h3>
        <div class="tablewrap">
          <table>
            <thead><tr><th>NODE</th><th>IP</th><th>LATENCY</th><th>STATE</th></tr></thead>
            <tbody id="nodes"></tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <span>SECURE SESSION // DEMO INTERFACE</span>
    <span>ENCRYPTION: AES-256</span>
  </footer>
</div>

<script>
const terminal = document.getElementById('terminal');
const lines = [
  '[BOOT] Initializing secure environment...',
  '[OK] Network interface connected',
  '[OK] Loading system modules',
  '[SCAN] Discovering active nodes...',
  '[INFO] 12 endpoints detected',
  '[AUTH] Session token verified',
  '[MONITOR] Packet stream active',
  '[SECURITY] Firewall rules synchronized',
  '[READY] Console online'
];
let idx=0;
function addLine(){
  if(idx>=lines.length){
    terminal.innerHTML += '<div class="line"><span class="prompt">root@monitor:~$</span> <span class="cursor"></span></div>';
    return;
  }
  const div=document.createElement('div');
  div.className='line';
  div.textContent=lines[idx++];
  terminal.appendChild(div);
  terminal.scrollTop=terminal.scrollHeight;
  setTimeout(addLine, 380);
}
addLine();

const nodes = [
 ['NODE-01','10.24.18.12','18 ms','ONLINE'],
 ['NODE-02','10.24.18.27','33 ms','ONLINE'],
 ['NODE-03','10.24.19.04','26 ms','ONLINE'],
 ['NODE-04','10.24.20.91','71 ms','CHECK'],
 ['NODE-05','10.24.21.37','22 ms','ONLINE'],
 ['NODE-06','10.24.22.14','45 ms','ONLINE'],
 ['NODE-07','10.24.23.66','29 ms','ONLINE'],
];
document.getElementById('nodes').innerHTML = nodes.map(n =>
  `<tr><td>${n[0]}</td><td>${n[1]}</td><td>${n[2]}</td><td class="${n[3]==='ONLINE'?'live':'warn'}">${n[3]}</td></tr>`
).join('');

setInterval(()=>{
  const cpu=Math.floor(35+Math.random()*35);
  const ram=Math.floor(55+Math.random()*25);
  const net=Math.floor(70+Math.random()*160);
  document.getElementById('cpu').textContent=cpu+'%';
  document.getElementById('ram').textContent=ram+'%';
  document.getElementById('net').textContent=net+' Mb/s';
  document.getElementById('cpuBar').style.width=cpu+'%';
  document.getElementById('ramBar').style.width=ram+'%';
  document.getElementById('netBar').style.width=Math.min(100,net/2.3)+'%';
},1400);

setInterval(()=>document.getElementById('clock').textContent=new Date().toLocaleTimeString(),1000);
</script>
</body>
</html>
